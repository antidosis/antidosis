# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database
# For serverless deploys (Vercel), use the Supabase pooler connection
# (port 6543, pgbouncer) instead of the direct connection (port 5432):
# postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# Rate limiting (Upstash Redis)
# Without these, rate limiting falls back to per-instance in-memory counters,
# which does not work across serverless instances — required in production.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Admin
# Comma-separated list of emails with admin access
ADMIN_EMAILS=admin@example.com

# Cron
# Bearer secret protecting /api/cron/* endpoints (e.g. the retention purge).
# Endpoint fails closed when unset. Vercel cron sends this automatically
# when configured in the project env.
CRON_SECRET=generate-a-long-random-string

# Stripe — optional while billing is parked (Pro is free; see AGENTS.md §1)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Email
RESEND_API_KEY=re_...

# SMS (Twilio Verify — owns code generation/delivery; no phone number purchase needed)
# Create a Verify Service in the Twilio console (Verify → Services) and use its VA... SID.
# Dev fallback: without these, codes are stored locally and logged to console (non-prod only).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Legacy — only needed if sending plain SMS instead of Verify
# TWILIO_PHONE_NUMBER=+614xxxxxxxx

# Google Play Billing — optional while billing is parked (see AGENTS.md §1)
GOOGLE_PLAY_PACKAGE_NAME=com.antidosis.app
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account-key.json

# Google Play RTDN (Pub/Sub push) verification — required for the webhook
# to accept messages; it fails closed (401) when unset
PLAY_RTDN_PUSH_AUDIENCE=https://your-domain.com/api/v1/billing/play-store/webhook
PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=your-pubsub-push-sa@your-project.iam.gserviceaccount.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Version string surfaced by /api/health (e.g. git SHA or package version)
NEXT_PUBLIC_APP_VERSION=dev
