generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id                     String    @id @default(uuid())
  userId                 String    @unique @map("user_id")
  email                  String    @unique
  handle                 String?   @unique
  fullName               String?   @map("full_name")
  bio                    String?
  directoryBio           String?               @map("directory_bio")
  avatarUrl              String?   @map("avatar_url")
  locationName           String?   @map("location_name")
  latitude               Float?
  longitude              Float?
  publicPhone            String?   @map("public_phone")
  privatePhone           String?   @map("private_phone")
  businessPhone          String?   @map("business_phone")
  businessEmail          String?   @map("business_email")
  // JSON array of the listing's own web presence:
  // [{"platform":"website","url":"https://…"}] — independent from the
  // personal socialLinks relation, which never appears on directory cards.
  businessSocialLinks    String?   @map("business_social_links")
  mobile                 String?   @unique
  mobileVerified         Boolean   @default(false) @map("mobile_verified")
  isVerified             Boolean   @default(false) @map("is_verified")
  isPro                  Boolean   @default(false) @map("is_pro")
  proActivatedAt         DateTime? @map("pro_activated_at")
  proSource              String?   @map("pro_source")
  proExpiresAt           DateTime? @map("pro_expires_at")
  showInDirectory        Boolean   @default(false) @map("show_in_directory")
  stripeCustomerId       String?   @map("stripe_customer_id")
  stripeSubscriptionId   String?   @map("stripe_subscription_id")
  playStorePurchaseToken String?   @map("play_store_purchase_token")
  playStoreProductId     String?   @map("play_store_product_id")
  playStoreAutoRenewing  Boolean?  @map("play_store_auto_renewing")
  ratingAvg              Float     @default(0) @map("rating_avg")
  ratingCount            Int       @default(0) @map("rating_count")
  jobsCompleted          Int       @default(0) @map("jobs_completed")
  abn                    String?
  accountType            String    @default("individual") @map("account_type")
  abnVerified            Boolean   @default(false) @map("abn_verified")
  audienceSize           Int?      @map("audience_size")
  // JSON blob of cross-device preferences: {"theme":"chrome","font":"system"}.
  // Appearance pickers PATCH this; the client applies it on devices that have
  // no local choice yet. Invalid shapes are ignored client-side.
  preferences            String?   @map("preferences")
  bannedAt               DateTime? @map("banned_at")
  bannedReason           String?   @map("banned_reason")
  lastSeenAt             DateTime? @map("last_seen_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  skills           Skill[]
  socialLinks      SocialLink[]
  credentials      Credential[]
  needsPosted      Need[]                @relation("NeedPoster")
  acceptances      Acceptance[]
  contractsAsA     Contract[]            @relation("ContractPartyA")
  contractsAsB     Contract[]            @relation("ContractPartyB")
  contractEvents   ContractEvent[]
  reviewsGiven     Review[]              @relation("ReviewGiver")
  reviewsReceived  Review[]              @relation("ReviewReceiver")
  messages         Message[]
  needMessages     NeedMessage[]
  notifications    Notification[]
  terminalMessages TerminalMessage[]
  dmThreadsAsA     DirectMessageThread[] @relation("DMUserA")
  dmThreadsAsB     DirectMessageThread[] @relation("DMUserB")
  directMessages   DirectMessage[]
  blocksInitiated  Block[]               @relation("blocksInitiated")
  blocksReceived   Block[]               @relation("blocksReceived")
  friendsAsA       Friend[]              @relation("friendsAsA")
  friendsAsB       Friend[]              @relation("friendsAsB")
  reportsFiled     Report[]
  supportRequests  SupportRequest[]
  directorySpecialties DirectorySpecialty[]
  deviceTokens     DeviceToken[]
  needWatches      NeedWatch[]

  @@index([isPro])
  @@index([stripeCustomerId])
  @@index([showInDirectory])
  @@index([accountType])
  @@index([lastSeenAt])
  @@map("profiles")
}

model SocialLink {
  id        String  @id @default(uuid())
  profileId String  @map("profile_id")
  platform  String
  url       String
  isPublic  Boolean @default(true) @map("is_public")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("social_links")
}

model Skill {
  id         String  @id @default(uuid())
  profileId  String  @map("profile_id")
  name       String
  category   String?
  isVerified Boolean @default(false) @map("is_verified")
  proofUrl   String? @map("proof_url")
  profile    Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("skills")
}

model Need {
  id                 String    @id @default(uuid())
  posterId           String    @map("poster_id")
  title              String
  description        String
  needCategory       String?   @map("need_category")
  offerType          String    @map("offer_type")
  offerDescription   String    @map("offer_description")
  offerValue         Float?    @map("offer_value")
  isLocal            Boolean   @default(true) @map("is_local")
  locationName       String?   @map("location_name")
  destinationName    String?   @map("destination_name")
  latitude           Float?
  longitude          Float?
  urgency            Int       @default(0)
  allowUrgentContact Boolean   @default(false) @map("allow_urgent_contact")
  status             String    @default("open")
  requiresContract   Boolean   @default(false) @map("requires_contract")
  deadline           DateTime?
  timeRange          String?   @map("time_range")
  images             String[]
  offerImages        String[]  @map("offer_images")
  // Gumtree-style monetisation: listing is always free; boostTier +
  // boostedUntil reserve paid top-placement / highlight slots. Nothing is
  // boosted today — readers treat a null boostedUntil as a normal listing.
  boostTier          String?   @map("boost_tier")
  boostedUntil       DateTime? @map("boosted_until")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  poster         Profile       @relation("NeedPoster", fields: [posterId], references: [id], onDelete: Cascade)
  requiredSkills NeedSkill[]
  acceptances    Acceptance[]
  contracts      Contract[]
  messages       NeedMessage[]
  views          NeedView[]
  watches        NeedWatch[]

  @@index([status, createdAt])
  @@index([posterId])
  @@index([needCategory])
  @@map("needs")
}

model NeedSkill {
  id     String @id @default(uuid())
  needId String @map("need_id")
  name   String
  need   Need   @relation(fields: [needId], references: [id], onDelete: Cascade)

  @@index([needId, name])
  @@map("need_skills")
}

model Acceptance {
  id                      String   @id @default(uuid())
  needId                  String   @map("need_id")
  userId                  String   @map("user_id")
  message                 String?
  status                  String   @default("pending")
  posterMarkedComplete    Boolean  @default(false) @map("poster_marked_complete")
  fulfillerMarkedComplete Boolean  @default(false) @map("fulfiller_marked_complete")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  need     Need          @relation(fields: [needId], references: [id], onDelete: Cascade)
  user     Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages NeedMessage[]
  reviews  Review[]

  @@unique([needId, userId])
  @@index([needId])
  @@index([userId])
  @@map("acceptances")
}

model Contract {
  id                     String    @id @default(uuid())
  needId                 String?   @map("need_id")
  acceptanceId           String?   @unique @map("acceptance_id")
  partyAId               String    @map("party_a_id")
  partyBId               String?   @map("party_b_id")
  kind                   String    @default("exchange")
  title                  String?
  description            String?
  considerationType      String?   @map("consideration_type")
  considerationValue     Float?    @map("consideration_value")
  inviteEmail            String?   @map("invite_email")
  inviteTokenHash        String?   @unique @map("invite_token_hash")
  invitedAt              DateTime? @map("invited_at")
  inviteExpiresAt        DateTime? @map("invite_expires_at")
  claimedAt              DateTime? @map("claimed_at")
  terms                  String
  partyATerms            String?   @map("party_a_terms")
  partyBTerms            String?   @map("party_b_terms")
  deadlineTerms          String?   @map("deadline_terms")
  completionMethodTerms  String?   @map("completion_method_terms")
  additionalTerms        String?   @map("additional_terms")
  partyAUseMessageTerms  Boolean   @default(false) @map("party_a_use_message_terms")
  partyBUseMessageTerms  Boolean   @default(false) @map("party_b_use_message_terms")
  negotiationMessages    Json?     @map("negotiation_messages")
  pdfUrl                 String?   @map("pdf_url")
  partyASubmittedAt      DateTime? @map("party_a_submitted_at")
  partyBSubmittedAt      DateTime? @map("party_b_submitted_at")
  partyAAgreedAt         DateTime? @map("party_a_agreed_at")
  partyBAgreedAt         DateTime? @map("party_b_agreed_at")
  termsLockedAt          DateTime? @map("terms_locked_at")
  partyASignedAt         DateTime? @map("party_a_signed_at")
  partyBSignedAt         DateTime? @map("party_b_signed_at")
  partyASignature        String?   @map("party_a_signature")
  partyBSignature        String?   @map("party_b_signature")
  status                 String    @default("draft")
  aMarkedComplete        Boolean   @default(false) @map("a_marked_complete")
  bMarkedComplete        Boolean   @default(false) @map("b_marked_complete")
  completedAt            DateTime? @map("completed_at")
  cancelledAt            DateTime? @map("cancelled_at")
  cancelledById          String?   @map("cancelled_by_id")
  cancelReason           String?   @map("cancel_reason")
  cancelRequestedById    String?   @map("cancel_requested_by_id")
  cancelRequestedAt      DateTime? @map("cancel_requested_at")
  cancelResponse         String?   @map("cancel_response")
  cancelResponseAt       DateTime? @map("cancel_response_at")
  cancelEscalatedAt      DateTime? @map("cancel_escalated_at")
  lastSignReminderSentAt DateTime? @map("last_sign_reminder_sent_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  need     Need?     @relation(fields: [needId], references: [id], onDelete: Cascade)
  partyA   Profile   @relation("ContractPartyA", fields: [partyAId], references: [id], onDelete: Cascade)
  partyB   Profile?  @relation("ContractPartyB", fields: [partyBId], references: [id], onDelete: Cascade)
  messages Message[]
  reviews  Review[]
  events   ContractEvent[]

  @@index([needId])
  @@index([partyAId])
  @@index([partyBId])
  @@index([status])
  @@index([kind, createdAt])
  @@map("contracts")
}

// Append-only contract audit trail. One row per state change or action,
// written autonomously at every mutation point. Never updated, never deleted
// (except with the contract itself).
model ContractEvent {
  id           String    @id @default(uuid())
  contractId   String    @map("contract_id")
  contract     Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  actorId      String?   @map("actor_id")
  actor        Profile?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action       String
  detail       Json?
  statusBefore String?   @map("status_before")
  statusAfter  String?   @map("status_after")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([contractId, createdAt])
  @@map("contract_events")
}

model NeedMessage {
  id           String   @id @default(uuid())
  needId       String   @map("need_id")
  senderId     String   @map("sender_id")
  acceptanceId String?  @map("acceptance_id")
  content      String
  isRead       Boolean  @default(false) @map("is_read")
  createdAt    DateTime @default(now()) @map("created_at")

  need       Need        @relation(fields: [needId], references: [id], onDelete: Cascade)
  sender     Profile     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  acceptance Acceptance? @relation(fields: [acceptanceId], references: [id], onDelete: Cascade)

  @@index([needId])
  @@index([needId, createdAt])
  @@index([needId, senderId, isRead])
  @@index([senderId])
  @@index([acceptanceId])
  @@map("need_messages")
}

model Message {
  id         String   @id @default(uuid())
  contractId String?  @map("contract_id")
  senderId   String   @map("sender_id")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
  isRead     Boolean  @default(false) @map("is_read")

  contract Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  sender   Profile   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([contractId, createdAt])
  @@index([contractId, senderId, isRead])
  @@index([senderId])
  @@map("messages")
}

model Review {
  id              String   @id @default(uuid())
  contractId      String?  @map("contract_id")
  acceptanceId    String?  @map("acceptance_id")
  giverId         String   @map("giver_id")
  receiverId      String   @map("receiver_id")
  rating          Int
  comment         String?
  privateFeedback String?  @map("private_feedback")
  createdAt       DateTime @default(now()) @map("created_at")

  contract   Contract?   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  acceptance Acceptance? @relation(fields: [acceptanceId], references: [id], onDelete: Cascade)
  giver      Profile     @relation("ReviewGiver", fields: [giverId], references: [id], onDelete: Cascade)
  receiver   Profile     @relation("ReviewReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([contractId, giverId])
  @@unique([acceptanceId, giverId])
  @@index([receiverId])
  @@index([contractId])
  @@index([acceptanceId])
  @@map("reviews")
}

model Credential {
  id              String    @id @default(uuid())
  profileId       String    @map("profile_id")
  type            String
  subType         String?   @map("sub_type")
  title           String
  description     String?
  documentNumber  String?   @map("document_number")
  issuedBy        String?   @map("issued_by")
  issuedAt        DateTime? @map("issued_at")
  expiresAt       DateTime? @map("expires_at")
  fileUrl         String?   @map("file_url")
  backFileUrl     String?   @map("back_file_url")
  isPublic        Boolean   @default(false) @map("is_public")
  isVerified      Boolean   @default(false) @map("is_verified")
  rejectionReason String?   @map("rejection_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([profileId, isPublic])
  @@index([isVerified])
  @@index([type])
  @@map("credentials")
}

model Notification {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  type       String
  title      String
  body       String
  data       Json?
  isRead     Boolean   @default(false) @map("is_read")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, archivedAt, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

model MobileVerificationCode {
  id        String   @id @default(uuid())
  mobile    String
  code      String
  profileId String   @map("profile_id")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([mobile])
  @@index([profileId])
  @@index([expiresAt])
  @@map("mobile_verification_codes")
}

model BannedMobile {
  id        String   @id @default(uuid())
  mobile    String   @unique
  reason    String?
  bannedAt  DateTime @default(now()) @map("banned_at")
  profileId String?  @map("profile_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([profileId])
  @@map("banned_mobiles")
}

model DirectorySpecialty {
  id         String   @id @default(uuid())
  profileId  String   @map("profile_id")
  profession String // taxonomy key from src/lib/professions.ts
  headline   String? // short pitch shown on the listing
  attributes String?  @map("attributes") // JSON blob of profession-specific answers
  slot       Int      @default(1) // 1 free; 2–3 are future paid unlocks
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, profession])
  @@index([profession])
  @@map("directory_specialties")
}

model SupportRequest {
  id          String    @id @default(uuid())
  profileId   String    @map("profile_id")
  reference   String    @unique // human-friendly ticket number shown to the member
  subject     String
  message     String
  status      String    @default("open") // "open" | "in_progress" | "resolved"
  response    String? // admin reply, visible to the member
  respondedAt DateTime? @map("responded_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([status, createdAt])
  @@map("support_requests")
}

model Report {
  id         String   @id @default(uuid())
  reporterId String   @map("reporter_id")
  targetType String   @map("target_type") // "need" | "profile" | "message"
  targetId   String   @map("target_id") // polymorphic — no FK
  reason     String // "scam" | "abuse" | "spam" | "safety" | "other"
  details    String?
  status     String   @default("open") // "open" | "resolved" | "dismissed"
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  reporter Profile @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model DeviceToken {
  id        String   @id @default(uuid())
  profileId String   @map("profile_id")
  token     String   @unique
  platform  String // "ios" | "android" | "web"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("device_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  event     String
  userId    String?  @map("user_id")
  email     String?
  ip        String?
  userAgent String?  @map("user_agent")
  path      String?
  metadata  Json?
  severity  String   @default("info")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([event])
  @@index([severity])
  @@index([createdAt])
  @@map("audit_logs")
}

model TerminalChannel {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  type        String   @default("public")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  messages TerminalMessage[]

  @@index([type])
  @@index([order])
  @@map("terminal_channels")
}

model TerminalMessage {
  id          String    @id @default(uuid())
  channelId   String    @map("channel_id")
  senderId    String    @map("sender_id")
  content     String
  attachments Json?     @default("[]")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  channel   TerminalChannel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender    Profile                   @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions TerminalMessageReaction[]

  @@index([channelId])
  @@index([channelId, createdAt])
  @@index([senderId])
  @@map("terminal_messages")
}

model TerminalMessageReaction {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message TerminalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("terminal_message_reactions")
}

model DirectMessageThread {
  id        String   @id @default(uuid())
  userAId   String   @map("user_a_id")
  userBId   String   @map("user_b_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages DirectMessage[]
  userA    Profile         @relation("DMUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    Profile         @relation("DMUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("direct_message_threads")
}

model DirectMessage {
  id          String    @id @default(uuid())
  threadId    String    @map("thread_id")
  senderId    String    @map("sender_id")
  content     String
  attachments Json?     @default("[]")
  isRead      Boolean   @default(false) @map("is_read")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  thread    DirectMessageThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    Profile                 @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions DirectMessageReaction[]

  @@index([threadId])
  @@index([threadId, createdAt])
  @@index([senderId])
  @@map("direct_messages")
}

model DirectMessageReaction {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("direct_message_reactions")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker Profile @relation("blocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Profile @relation("blocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Friend {
  id        String   @id @default(uuid())
  userAId   String   @map("user_a_id")
  userBId   String   @map("user_b_id")
  createdAt DateTime @default(now()) @map("created_at")

  userA Profile @relation("friendsAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userB Profile @relation("friendsAsB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("friends")
}

model NeedView {
  id        String   @id @default(uuid())
  needId    String   @map("need_id")
  // Nullable: anonymous visitors count too. No FK — view history must survive
  // account anonymisation, and counts are aggregated from rows.
  viewerId  String?  @map("viewer_id")
  ipHash    String?  @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at")

  need Need @relation(fields: [needId], references: [id], onDelete: Cascade)

  @@index([needId, createdAt])
  @@index([needId, viewerId])
  @@index([needId, ipHash])
  @@map("need_views")
}

model NeedWatch {
  id        String   @id @default(uuid())
  needId    String   @map("need_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  need Need    @relation(fields: [needId], references: [id], onDelete: Cascade)
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([needId, userId])
  @@index([userId])
  @@map("need_watches")
}

// Note: Additional Profile indexes
// isPro, stripeCustomerId, showInDirectory, lastSeenAt are declared on the model above
